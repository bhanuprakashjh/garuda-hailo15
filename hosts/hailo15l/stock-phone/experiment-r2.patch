+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <stdexcept>
+
+namespace garuda_experiment {
+// Fail closed for unvalidated DSP rounding cases. Current 16:9 and square
+// layouts produce exact even content and even centered padding at 640x640.
+inline std::array<double,4> letterbox_content(int sw,int sh,int dw,int dh) {
+    if(sw<=0||sh<=0||dw<=0||dh<=0) throw std::invalid_argument("invalid letterbox dimensions");
+    const double scale=std::min(double(dw)/sw,double(dh)/sh);
+    const double w=sw*scale,h=sh*scale,x=(dw-w)/2,y=(dh-h)/2;
+    for(double n:{w,h,x,y})
+        if(std::abs(n/2-std::round(n/2))>1e-6)
+            throw std::invalid_argument("unvalidated DSP letterbox rounding");
+    return {x/dw,y/dh,w/dw,h/dh};
+}
+inline std::array<double,4> undo_letterbox(std::array<double,4> box,
+                                         const std::array<double,4>& content) {
+    return {std::clamp((box[0]-content[0])/content[2],0.0,1.0),
+            std::clamp((box[1]-content[1])/content[3],0.0,1.0),
+            std::clamp((box[2]-content[0])/content[2],0.0,1.0),
+            std::clamp((box[3]-content[1])/content[3],0.0,1.0)};
+}
+}
