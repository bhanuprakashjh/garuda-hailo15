+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <unistd.h>
+#include <sys/statvfs.h>
+#include <media_library/buffer_pool.hpp>
+
+namespace garuda_experiment {
+// Diagnostic only: encoded access units plus their exact source timestamps.
+// Up to 900 frames / 64 MiB per request; two captures per process. No overwrite.
+// Synchronous writes can affect timing: measure and report capture cadence.
+class Recorder {
+    FILE *video=nullptr,*index=nullptr;
+    size_t bytes=0,frames=0,runs=0,polls=0;
+    void finish(const char* reason){
+        if(index) {std::fprintf(index,"{\"end\":true,\"frames\":%zu,\"bytes\":%zu,\"reason\":\"%s\"}\n",frames,bytes,reason);std::fclose(index);index=nullptr;}
+        if(video){std::fclose(video);video=nullptr;}
+    }
+public:
+    ~Recorder(){finish("shutdown");}
+    void append(HailoMediaLibraryBufferPtr buffer,size_t size){
+        if(!video){
+            if(runs>=2 || ++polls%30 || !std::getenv("GARUDA_RECORD_ENABLE"))return;
+            if(access("/tmp/garuda-r2-record.request",F_OK))return;
+            struct statvfs space{};
+            if(statvfs("/tmp",&space)||space.f_bavail*space.f_frsize<256ULL*1024*1024)return;
+            char folder[]="/tmp/garuda-r2-record.XXXXXX";
+            if(!mkdtemp(folder))return;
+            video=std::fopen((std::string(folder)+"/video.h264").c_str(),"wbx");
+            index=std::fopen((std::string(folder)+"/frames.jsonl").c_str(),"wx");
+            if(!video||!index){finish("open_error");return;}
+            unlink("/tmp/garuda-r2-record.request");++runs;bytes=frames=0;
+            std::fprintf(stderr,"GARUDA_RECORD_STARTED %s\n",folder);
+        }
+        if(bytes+size>64ULL*1024*1024){finish("byte_limit");return;}
+        if(!buffer->isp_timestamp_ns||size>buffer->get_plane_size(0)) {finish("invalid_frame");return;}
+        if(std::fwrite(buffer->get_plane_ptr(0),1,size,video)!=size){finish("write_error");return;}
+        if(std::fprintf(index,"{\"frame\":%zu,\"offset\":%zu,\"bytes\":%zu,\"source_timestamp_ns\":\"%llu\"}\n",
+            frames,bytes,size,(unsigned long long)buffer->isp_timestamp_ns)<0){finish("index_error");return;}
+        bytes+=size;++frames;
+        if(frames>=900)finish("frame_limit");
+    }
+};
+}
